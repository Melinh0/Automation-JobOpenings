# Dados pessoais (preencha com seus dados reais no .env)
NOME_COMPLETO=Seu Nome Completo
NOME_MAE=Nome da sua mãe
NOME_PAI=Nome do seu pai
CPF=00000000000
RG=00000000
TELEFONE=(00) 00000-0000
LINKEDIN=https://www.linkedin.com/in/seu-perfil/
GITHUB=https://github.com/seu-usuario
CEP=00000-000
BAIRRO=Seu bairro
RUA=Sua rua
NUMERO=000
CIDADE=Sua cidade
ESTADO=UF

# API Ollama
OLLAMA_API_KEY=sua_chave_api_ollama
